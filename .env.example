# Quebit Configuration
# Copy this to .env and adjust values as needed.

DATABASE_URL=postgres://quebit:quebit@localhost:5432/quebit?sslmode=disable
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
PROVIDER_URL=http://localhost:9090
PROVIDER_API_KEY=
WORKER_CONCURRENCY=10
RATE_LIMIT_RPS=100
# Comma-separated CIDRs of proxies whose X-Forwarded-For / X-Real-IP headers are
# trusted for rate limiting. Empty means those headers are ignored (safest).
TRUSTED_PROXIES=
LOG_LEVEL=INFO

# --- Optional tuning (defaults shown; durations use Go syntax: 250ms, 30s, 10m) ---
#HTTP_READ_TIMEOUT=10s
#HTTP_WRITE_TIMEOUT=10s
#HTTP_IDLE_TIMEOUT=60s
#HTTP_SHUTDOWN_TIMEOUT=30s
#HEALTH_TIMEOUT=3s
#PROVIDER_TIMEOUT=10s
#WORKER_SHUTDOWN_TIMEOUT=30s
#OUTBOX_RELAY_INTERVAL=250ms
#OUTBOX_RELAY_BATCH=100
#OUTBOX_SWEEP_INTERVAL=30s
#OUTBOX_SWEEP_STALE_AGE=60s
#OUTBOX_REAP_INTERVAL=30s
